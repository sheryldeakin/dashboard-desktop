MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
MONGODB_DB=dashboard_display
MONGODB_COLLECTION=dashboard_content
CONTENT_KEY=main

# Comma-separated list. Example:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=

# Shared-secret bearer token. When set, /api/content requires
# `Authorization: Bearer <token>`; when EMPTY the API is UNAUTHENTICATED
# (fail-open, for local dev). Set the SAME value here, as VITE_API_TOKEN in
# web/.env, and in the sync scripts' env to turn on auth in production.
API_TOKEN=

# Optional for migration script:
# MIGRATE_ALL_KEYS=true
